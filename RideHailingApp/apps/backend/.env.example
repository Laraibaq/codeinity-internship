# ==============================================================================
# RideHailingApp Backend Environment Configuration Template
# ==============================================================================
# Security Notice: NEVER commit real production secrets, passwords, or tokens.
# Duplicate this file to .env and configure environment-specific values.

# ------------------------------------------------------------------------------
# 1. Server & Environment
# ------------------------------------------------------------------------------
NODE_ENV=development # Set to 'production' for production deployments
PORT=3000

# Comma-separated list of allowed web origins for CORS and Socket.IO
# In production, set this to your exact frontend domain(s)
CORS_ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,https://admin.yourdomain.com"

# ------------------------------------------------------------------------------
# 2. Database (PostgreSQL / Supabase)
# ------------------------------------------------------------------------------
# Shared Supabase Postgres instance (PostGIS enabled).
# Always use the "Session pooler" string (port 5432) for migrations and pooling compatibility.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# 3. Authentication & JWT Tokens
# ------------------------------------------------------------------------------
# Generate cryptographically secure 256-bit keys (e.g. `openssl rand -hex 32`)
JWT_ACCESS_SECRET="<generate-your-own-random-hex-secret>"
JWT_ACCESS_EXPIRES_IN=900 # 15 minutes (in seconds)
JWT_REFRESH_SECRET="<generate-your-own-random-hex-secret>"
JWT_REFRESH_EXPIRES_IN=2592000 # 30 days (in seconds)

# ------------------------------------------------------------------------------
# 4. Supabase Storage (Driver Documents & Assets)
# ------------------------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY bypasses Row Level Security for server-side uploads.
# Backend-only: NEVER expose this to mobile or web clients.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="<generate-your-own-service-role-key>"

# ------------------------------------------------------------------------------
# 5. Payments & Webhooks
# ------------------------------------------------------------------------------
# Secret used to verify HMAC SHA256 signatures on incoming gateway webhooks
PAYMENT_WEBHOOK_SECRET="<generate-your-own-random-webhook-secret>"

# Gateway API credentials for live acquirers (Stripe / JazzCash / EasyPaisa)
PAYMENT_PROVIDER_SECRET=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
JAZZCASH_SECRET_KEY=""
JAZZCASH_WEBHOOK_SECRET=""

# ------------------------------------------------------------------------------
# 6. Push Notifications (Expo Push Service)
# ------------------------------------------------------------------------------
# Optional Expo access token if authenticated push notification quota is required
EXPO_ACCESS_TOKEN=""
