// Prisma schema for RideHailingApp backend.
// Entities and fields follow /docs/Dependencies.docx §5 "Database Schema — MVP1 Entities".

generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
  // This backend has no "type": "module" anywhere (it's CommonJS), but the generator's ESM
  // default emits `import.meta.url` that breaks when tsc downcompiles it to CJS without a
  // matching package.json boundary. Forcing cjs output here matches reality and needs no
  // extra build-step/asset-copying to keep working.
  moduleFormat    = "cjs"
}

datasource db {
  provider   = "postgresql"
  extensions = [postgis]
}

enum VerificationStatus {
  pending
  approved
  rejected
  suspended
}

enum VehicleType {
  car
  bike
  rickshaw
}

enum RideStatus {
  requested
  offered
  accepted
  en_route
  arrived
  ongoing
  completed
  cancelled
}

// Ride.vehicleType vs Ride.fareTier -- these are deliberately two separate concepts. Do not
// collapse them back into one enum; a future session without this context is likely to try.
//
// - VehicleType (car/bike/rickshaw) describes what a driver PHYSICALLY DRIVES. It already exists
//   on Vehicle (a driver's own registered vehicle) and is reused as-is on Ride.vehicleType so a
//   ride can record/filter on driver-matching eligibility (e.g. "only match rickshaw drivers").
// - RideFareTier (standard/premium/xl/bike) describes a PRICING/COMFORT TIER the passenger picked
//   in the app -- it has no necessary relationship to the vehicle's body type. A "premium" tier
//   could in principle be fulfilled by any body type; this app's matching rules (still to be
//   built) decide how tightly the two are coupled, not the schema.
// Before this change, the frontend's standard/premium/xl/bike vocabulary had nowhere to persist on
// Ride at all, and the only enum available (VehicleType: car/bike/rickshaw) covered a different
// concept entirely -- see the Phase 0 audit's "vehicle type enum mismatch" finding.
enum RideFareTier {
  standard
  premium
  xl
  bike
}

enum OfferType {
  accept
  reject
  counter
}

enum OfferStatus {
  pending
  accepted
  rejected
  expired
}

enum RatingRole {
  passenger
  driver
}

enum NegotiationStatus {
  active
  accepted
  rejected
  expired
  cancelled
}

enum NegotiationOfferType {
  initial
  counter
  accept
}

enum NegotiationOfferStatus {
  pending
  accepted
  rejected
  expired
  superseded
}

// Passengers.
model User {
  id              String   @id @default(uuid()) @db.Uuid
  name            String
  phone           String   @unique
  email           String?  @unique
  passwordHash    String
  phoneVerified   Boolean  @default(false)
  profilePhotoUrl String?
  rating          Float?
  rideCount       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  rides        Ride[]        @relation("PassengerRides")
  negotiations Negotiation[]

  @@map("users")
}

model Driver {
  id                 String             @id @default(uuid()) @db.Uuid
  name               String
  phone              String             @unique
  email              String?            @unique
  passwordHash       String
  phoneVerified      Boolean            @default(false)
  profilePhotoUrl    String?
  licenseNumber      String?
  // Front/back are two separate uploads (register-license-upload.tsx) -- unlike cnicDocUrl below
  // (one identity document), a driving license has meaningfully different content on each side.
  licenseDocFrontUrl String?
  licenseDocBackUrl  String?
  cnicNumber         String?
  cnicDocUrl         String?
  verificationStatus VerificationStatus @default(pending)
  rating             Float?
  isOnline           Boolean            @default(false)
  currentLat         Float?
  currentLng         Float?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  vehicle        Vehicle?
  rides          Ride[]          @relation("DriverRides")
  rideOffers     RideOffer[]
  negotiations   Negotiation[]
  notifications  Notification[]
  supportTickets SupportTicket[]

  @@map("drivers")
}

model Vehicle {
  id       String       @id @default(uuid()) @db.Uuid
  driverId String       @unique @db.Uuid
  // All nullable: a vehicle document/photo can be uploaded (POST /drivers/me/documents, which
  // upserts a minimal row keyed by driverId) before the vehicle-info text fields are ever
  // submitted via their own future endpoint.
  type               VehicleType?
  make               String?
  model              String?
  color              String?
  registrationNumber String?      @unique
  registrationDocUrl String?
  insuranceDocUrl    String?
  photoFrontUrl      String?
  photoSideUrl       String?
  photoBackUrl       String?
  photoInteriorUrl   String?

  driver Driver @relation(fields: [driverId], references: [id])

  @@map("vehicles")
}

model Ride {
  id                String     @id @default(uuid()) @db.Uuid
  passengerId       String     @db.Uuid
  driverId          String?    @db.Uuid
  pickupLat         Float
  pickupLng         Float
  pickupAddress     String
  dropoffLat        Float
  dropoffLng        Float
  dropoffAddress    String
  distanceKm        Float
  etaMinutes        Int
  proposedFare      Decimal    @db.Decimal(10, 2)
  aiRecommendedFare Decimal    @db.Decimal(10, 2)
  finalFare         Decimal?   @db.Decimal(10, 2)
  // Body type for driver-matching eligibility; see the enum comment above for why this is
  // separate from fareTier. Nullable: existing rows have neither, and ride-creation isn't wired
  // to send either yet (that's Phase 3 frontend work) -- this phase only adds the columns.
  vehicleType       VehicleType?
  // Pricing/comfort tier the passenger picked (standard/premium/xl/bike); see the enum comment
  // above. Nullable for the same reason as vehicleType.
  fareTier          RideFareTier?
  status            RideStatus @default(requested)
  requestedAt       DateTime   @default(now())
  startedAt         DateTime?
  completedAt       DateTime?
  cancelledAt       DateTime?

  passenger         User               @relation("PassengerRides", fields: [passengerId], references: [id])
  driver            Driver?            @relation("DriverRides", fields: [driverId], references: [id])
  offers            RideOffer[]
  negotiations      Negotiation[]
  negotiationOffers NegotiationOffer[]
  ratings           Rating[]
  supportTickets    SupportTicket[]
  payment           Payment?

  @@map("rides")
}

model RideOffer {
  id          String      @id @default(uuid()) @db.Uuid
  rideId      String      @db.Uuid
  driverId    String      @db.Uuid
  offerType   OfferType
  offerAmount Decimal?    @db.Decimal(10, 2)
  status      OfferStatus @default(pending)
  createdAt   DateTime    @default(now())
  expiresAt   DateTime

  ride   Ride   @relation(fields: [rideId], references: [id])
  driver Driver @relation(fields: [driverId], references: [id])

  @@map("ride_offers")
}

model Rating {
  id         String     @id @default(uuid()) @db.Uuid
  rideId     String     @db.Uuid
  // fromUserId/toUserId intentionally have no FK relation: fromRole determines
  // whether the actor is a User or a Driver, so the id can't target a single table.
  fromUserId String     @db.Uuid
  toUserId   String     @db.Uuid
  fromRole   RatingRole
  score      Int
  comment    String?
  createdAt  DateTime   @default(now())

  ride Ride @relation(fields: [rideId], references: [id])

  @@unique([rideId, fromUserId])
  @@map("ratings")
}

enum NotificationType {
  account
  ride
  support
  system
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  driverId  String           @db.Uuid
  title     String
  message   String
  type      NotificationType @default(system)
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  driver Driver @relation(fields: [driverId], references: [id])

  @@map("notifications")
}

enum SupportCategory {
  ride
  account
  vehicle_document
  technical
  safety
  other
}

enum SupportStatus {
  open
  resolved
}

model SupportTicket {
  id          String          @id @default(uuid()) @db.Uuid
  driverId    String          @db.Uuid
  rideId      String?         @db.Uuid
  category    SupportCategory
  subject     String
  description String
  status      SupportStatus   @default(open)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  driver Driver @relation(fields: [driverId], references: [id])
  ride   Ride?  @relation(fields: [rideId], references: [id])

  @@map("support_tickets")
}

model DeviceToken {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  userRole   String
  token      String   @unique
  platform   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  lastSeenAt DateTime @default(now())

  @@index([userId])
  @@map("device_tokens")
}

enum PaymentStatus {
  pending
  processing
  succeeded
  failed
  refunded
  partially_refunded
}

enum PaymentMethod {
  cash
  wallet
  card
}

enum LedgerEntryType {
  credit
  debit
}

enum LedgerReferenceType {
  ride_payment
  driver_earning
  refund
  topup
  platform_fee
}

model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  rideId            String        @unique @db.Uuid
  passengerId       String        @db.Uuid
  driverId          String        @db.Uuid
  amount            Decimal       @db.Decimal(10, 2)
  currency          String        @default("PKR")
  paymentMethod     PaymentMethod @default(cash)
  status            PaymentStatus @default(pending)
  provider          String?
  providerPaymentId String?
  idempotencyKey    String?       @unique
  failureReason     String?
  refundedAmount    Decimal       @default(0.00) @db.Decimal(10, 2)
  paidAt            DateTime?
  failedAt          DateTime?
  refundedAt        DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  ride Ride @relation(fields: [rideId], references: [id])

  @@index([passengerId])
  @@index([driverId])
  @@index([status])
  @@map("payments")
}

model Wallet {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @db.Uuid
  userRole  String
  balance   Decimal  @default(0.00) @db.Decimal(10, 2)
  currency  String   @default("PKR")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions WalletTransaction[]

  @@map("wallets")
}

model WalletTransaction {
  id             String              @id @default(uuid()) @db.Uuid
  walletId       String              @db.Uuid
  userId         String              @db.Uuid
  type           LedgerEntryType
  amount         Decimal             @db.Decimal(10, 2)
  currency       String              @default("PKR")
  referenceType  LedgerReferenceType
  referenceId    String?
  balanceBefore  Decimal             @db.Decimal(10, 2)
  balanceAfter   Decimal             @db.Decimal(10, 2)
  idempotencyKey String?             @unique
  description    String?
  createdAt      DateTime            @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id])

  @@index([userId])
  @@index([walletId])
  @@map("wallet_transactions")
}

model Negotiation {
  id                String            @id @default(uuid()) @db.Uuid
  rideId            String            @db.Uuid
  driverId          String            @db.Uuid
  passengerId       String            @db.Uuid
  status            NegotiationStatus @default(active)
  currentAmount     Decimal           @db.Decimal(10, 2)
  currentProposerId String            @db.Uuid
  acceptedAt        DateTime?
  expiresAt         DateTime
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  ride        Ride               @relation(fields: [rideId], references: [id])
  driver      Driver             @relation(fields: [driverId], references: [id])
  passenger   User               @relation(fields: [passengerId], references: [id])
  offers      NegotiationOffer[]

  @@unique([rideId, driverId])
  @@index([rideId])
  @@index([driverId])
  @@index([passengerId])
  @@index([status])
  @@map("negotiations")
}

model NegotiationOffer {
  id             String                 @id @default(uuid()) @db.Uuid
  negotiationId  String                 @db.Uuid
  rideId         String                 @db.Uuid
  proposerId     String                 @db.Uuid
  recipientId    String                 @db.Uuid
  amount         Decimal                @db.Decimal(10, 2)
  type           NegotiationOfferType   @default(counter)
  status         NegotiationOfferStatus @default(pending)
  reason         String?
  idempotencyKey String?                @unique
  expiresAt      DateTime
  createdAt      DateTime               @default(now())

  negotiation Negotiation @relation(fields: [negotiationId], references: [id])
  ride        Ride        @relation(fields: [rideId], references: [id])

  @@index([negotiationId])
  @@index([rideId])
  @@index([proposerId])
  @@index([status])
  @@map("negotiation_offers")
}

model Admin {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique
  passwordHash String
  name         String
  role         String     @default("admin")
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  auditLogs    AuditLog[]

  @@map("admins")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  adminId    String   @db.Uuid
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  admin      Admin    @relation(fields: [adminId], references: [id])

  @@index([adminId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// Persisted replacement for OtpService's old in-memory Map -- codes now survive a server restart
// and are shared across instances, and a code is no longer trivially "valid" (the old
// implementation accepted any 6-digit string). `purpose` namespaces the code the same way the old
// Map key did (e.g. "signup" vs "password-reset"), so a code issued for one flow can't verify the
// other for the same identifier. `codeHash` stores a SHA-256 hash, not the plaintext code, so a
// database read alone doesn't disclose live codes. `attempts` counts failed verify() calls against
// this row; OtpService deletes the row once attempts reach its own max-attempts limit, forcing a
// resend rather than allowing unlimited guesses against one issued code.
model OtpCode {
  id         String   @id @default(uuid()) @db.Uuid
  purpose    String
  identifier String
  codeHash   String
  attempts   Int      @default(0)
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  // One live code per purpose+identifier -- requesting a new one (e.g. "Resend") replaces
  // whatever was pending, same as the old Map's Map.set() overwrite behavior.
  @@unique([purpose, identifier])
  @@map("otp_codes")
}

