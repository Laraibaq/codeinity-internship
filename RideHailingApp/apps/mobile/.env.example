# Backend API base URL. EXPO_PUBLIC_-prefixed vars are inlined by Expo at build time -- copy this
# file to .env and adjust per how you're running the app:
#
# - iOS Simulator / Android Emulator on this same machine: localhost works as-is.
# - Expo Go / a dev client on a physical device: localhost resolves to the PHONE, not this machine
#   -- use this machine's LAN IP instead, e.g. http://192.168.1.23:3000.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
